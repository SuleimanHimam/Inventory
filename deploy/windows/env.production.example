# Copy to server\.env on the server. Node reads it directly (--env-file), so the
# service definition holds no secrets.
#
# Restart after any change:  Restart-Service inventory-api

NODE_ENV=production

# ---------------------------------------------------------------- network
# Loopback only. Caddy is the sole route in, which is what makes TLS mandatory
# rather than optional — bind 0.0.0.0 here and port 4317 becomes reachable in
# clear text by anything that can route to this machine.
HOST=127.0.0.1
PORT=4317

# ---------------------------------------------------------------- database
# Local Postgres. Use the least-privilege app_api role, not the postgres
# superuser: a superuser bypasses every Row Level Security policy, which is the
# database-level half of tenant isolation.
#
#   psql -U postgres -c "ALTER ROLE app_api WITH LOGIN PASSWORD 'a-long-random-password';"
#
# Verify before trusting it:  cd server; npm run doctor   (want: bypasses RLS: no)
DATABASE_URL=postgresql://app_api:CHANGE-ME@127.0.0.1:5432/inventory

# ---------------------------------------------------------------- auth
# ⚠ AUTH_MODE=none means the API verifies nobody: one shared organisation, and
# anyone who reaches the URL can read and change every row. That is survivable
# on a private LAN. On a public domain it is not — the port will be found.
#
# Supabase Auth needs no Supabase *database* and costs nothing: create a project,
# enable Authentication → Providers → Email, and put the project URL here. The
# frontend needs VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY at build time.
AUTH_MODE=supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Only for projects using the legacy shared HS256 secret. With Supabase's newer
# asymmetric signing keys, SUPABASE_URL alone is enough (verified via JWKS).
#SUPABASE_JWT_SECRET=

# First sign-in creates an organisation for a user who has none. Turn this off
# once the real accounts exist, so a stranger with a valid token cannot
# provision themselves a tenant.
ALLOW_AUTO_PROVISION=1

# ---------------------------------------------------------------- storage
# On your own server this is the *good* option: a real disk that survives a
# restart, unlike a container filesystem. Back it up with the database — the
# rows reference filenames, so a database restore without the files leaves
# broken images.
STORAGE_DRIVER=local
UPLOADS_DIR=C:\inventory\data\uploads

# ---------------------------------------------------------------- cors
# Caddy serves the frontend and the API on one origin, so this is the site's own
# URL. Never '*' on a public deployment.
CORS_ORIGIN=https://inventory.example.com
