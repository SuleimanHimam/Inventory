# ---------------------------------------------------------------------------
# API environment. Copy to server/.env for local development; on Render set the
# same keys under Environment. `npm run dev` loads .env automatically.
# ---------------------------------------------------------------------------

# SQL Server. `server` accepts the sqlcmd "host\instance" form directly — SQL
# Browser (UDP 1434) resolves the instance's port, so no separate port var is
# needed unless the instance was pinned to a static TCP port.
DB_SERVER=127.0.0.1\INVENTORY
DB_NAME=inventory
DB_USER=app_api
DB_PASSWORD=
# On-prem instance with no TLS certificate — set to true only if one is
# configured (e.g. an Azure SQL / managed instance).
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# --- retired (PostgreSQL build) ---------------------------------------------
# DATABASE_URL=postgres://inventory:inventory@127.0.0.1:5433/inventory?sslmode=disable
# TEST_DATABASE_URL=postgres://inventory:inventory@127.0.0.1:5433/inventory?sslmode=disable

# --- auth -------------------------------------------------------------------
# 'supabase' verifies a Supabase Auth access token on every request.
# 'local' verifies a token this API issued itself, backed by the `users`
# table — email + password, no third party. See routes/auth.routes.js.
# 'none' skips verification and runs everything as a local dev user; refused
# when NODE_ENV=production.
AUTH_MODE=none

# Supabase project (Project settings → API). SUPABASE_JWT_SECRET is under
# Project settings → API → JWT keys; SUPABASE_URL alone is enough for projects
# using the newer asymmetric signing keys, verified through JWKS.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_JWT_SECRET=

# AUTH_MODE=local only: a long random string that signs local login tokens.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=

# Create an organisation automatically for a user who signs in without one.
# Fine for a pilot; set to 0 once organisations are provisioned deliberately.
ALLOW_AUTO_PROVISION=1

# --- frontend ---------------------------------------------------------------
# Exact origins allowed to call this API. Never '*'.
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# Optional: match Vercel's per-commit preview URLs.
# CORS_ORIGIN_REGEX=^https://inventory-[a-z0-9-]+\.vercel\.app$

# --- product photos ---------------------------------------------------------
# 'local' writes to server/data/uploads — fine for development, but Render's
# free tier has an ephemeral filesystem, so uploads there disappear on redeploy.
# 'supabase' stores them in a Storage bucket instead (the default once the two
# SUPABASE_* keys below are present).
STORAGE_DRIVER=local
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=item-images

# --- misc -------------------------------------------------------------------
PORT=4317
# Transport cap for the Excel importer, in MB.
IMPORT_MAX_FILE_MB=10
# SKIP_MIGRATIONS=1 to boot without applying pending migrations.
