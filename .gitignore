node_modules/
dist/
build/
secrets/
backups/

# The retired Electron shell and its installers (~470 MB). Kept on disk only
# because this working copy had no version control when it was retired — see
# legacy-desktop/README.md. Never commit it: individual installers exceed
# GitHub's 100 MB per-file limit.
legacy-desktop/

# Local uploads and scratch data. Product photos are business data, not source:
# they live on the server's disk and inside the SQL backups. `data/` is where the
# self-hosted deployment writes them; `server/data/` was the path before that.
data/
server/data/
server/.tmp/

# Screenshots from driving the app
.shots/

# Build caches
*.tsbuildinfo

# Logs / editor / OS. The whole folder, not just *.log: the service's own logs
# are .log, but diagnostics dropped next to them (SQL Server ERRORLOG excerpts
# and the like) are not, and they name the machine and its instances.
logs/
*.log
npm-debug.log*
.vscode/
.idea/
.DS_Store
Thumbs.db

# Environment — never commit a real one; .env.example is the documentation
.env
.env.*
!.env.example

# Vendored agent skills (installed via `npx skills add`) — regenerate, do not edit
.agents/
.claude/skills/

# Deploy rollback copies of client/dist. Ignored so the Tailwind scanner
# does not read stale bundles and resurrect dead utility classes from them.
dist.backup-*/

# Ad-hoc data backups (draft invoices, exports) — never commit business data
backups/
