<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS configuration for the inventory app.

  THIS is the authoritative copy. `vite build` wipes client/dist and then
  copies everything in client/public/ into it, so a web.config kept anywhere
  else is silently replaced by this one on the next build — which is exactly
  what happened to an earlier copy under deploy/windows/, taking its cache
  rules with it and leaving the deployment running on the pre-fix config for
  days. Edit this file; there is no manual copy step.

  Requires the IIS URL Rewrite and Application Request Routing modules, with
  ARR's proxy feature turned on — see deploy/windows/README.md.

  The app uses hash routing, so no SPA fallback rewrite is needed: every
  navigable URL is served by index.html at the site root already.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <rewrite>
      <rules>
        <!-- The API, on loopback-only port 4317, reachable same-origin. -->
        <rule name="Inventory API reverse proxy" stopProcessing="true">
          <match url="^api/v1/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:4317/api/v1/{R:1}" />
        </rule>

        <!--
          Item photos. `mediaUrl()` builds these as same-origin absolute paths
          (/uploads/<id>.jpg) because VITE_API_URL is empty in production, so
          without this rule every photo in the app 404s at the IIS layer while
          answering perfectly well on :4317 directly — which is how it looks
          when a thumbnail is missing but nothing appears wrong server-side.
        -->
        <rule name="Inventory uploads reverse proxy" stopProcessing="true">
          <match url="^uploads/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:4317/uploads/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>

  <!--
    Caching. This is load-bearing, not an optimisation.

    Without an explicit Cache-Control header IIS sends only ETag/Last-Modified,
    and browsers then apply *heuristic* caching: they invent a freshness
    lifetime from Last-Modified and serve the stored copy without revalidating.
    The Android home-screen shortcut this deployment is used through is the
    most aggressive about it.

    index.html is the one file Vite does not content-hash, so a stale copy of
    it keeps pointing at asset filenames from an older build: the deploy lands
    on disk, the server serves it correctly, and the device still shows the
    previous version. Every "nothing changed on my phone" report so far has
    been this and not the change itself.

    So: never cache the entry points, cache the hashed assets forever.
  -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <!-- Filenames carry a content hash, so a changed file is a changed URL
             and this can never serve something stale. -->
        <clientCache cacheControlMode="UseMaxAge"
                     cacheControlMaxAge="365.00:00:00"
                     cacheControlCustom="immutable" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Same reasoning: neither is content-hashed, and both are read on boot. -->
  <location path="manifest.webmanifest">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="theme.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <!--
    Icons are not content-hashed either, and a home-screen shortcut's icon is
    read once and then kept by the launcher — so a heuristically cached copy
    means a new icon simply never appears on a device that already installed
    the old one. They are a few KB each; revalidating them costs nothing next
    to shipping a change nobody can see.
  -->
  <location path="icons">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="favicon.svg">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
