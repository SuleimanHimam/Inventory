# ---------------------------------------------------------------------------
# Frontend environment. Copy to client/.env.local for development; on Vercel set
# the same keys under Settings → Environment Variables.
#
# Vite inlines these at build time, so they are public by definition — never put
# a service-role key or any secret here. The anon key is designed to be public.
# ---------------------------------------------------------------------------

# The API's origin, without a trailing slash. Leave unset in development to use
# the same-origin Vite proxy instead.
# VITE_API_URL=https://inventory-api.onrender.com

# Supabase project (Project settings → API). With both unset the app runs
# without a login screen, which pairs with the server's AUTH_MODE=none.
# VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=

# Idle-session timeout (only matters once a login screen is active — see
# above). Minutes of no mouse/keyboard/touch/scroll activity before the
# warning modal shows, and how many seconds its countdown runs before
# signing out automatically. Both optional; defaults are 15 and 60.
# VITE_IDLE_TIMEOUT_MINUTES=15
# VITE_IDLE_WARNING_SECONDS=60
